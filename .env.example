# ==========================================
# DanceOne Environment Configuration Example
# ==========================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Provider Selection (Supported: mongodb | postgres)
DB_TYPE=mongodb

# Local MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/danceone

# Future PostgreSQL Connection (Uncomment and replace when ready)
# POSTGRES_URI=postgresql://postgres:password@localhost:5432/danceone

# Security & Authentication
JWT_SECRET=danceone_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Frontend API Base URL (used by Vite client)
VITE_API_BASE_URL=http://localhost:5000/api

# Gemini AI Integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
